# LLM API Key（DeepSeek：https://platform.deepseek.com；智谱：https://open.bigmodel.cn）
LLM_API_KEY=

# OpenAI 兼容接口配置（默认 DeepSeek V4 Flash；可切换智谱 GLM 等）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 可选覆盖（默认值见 app/config.py）
# DB_PATH=data/pom.db
# DATA_DIR=data/StarRailData
# DIALOGUES_DIR=data/dialogues
# MODEL_CACHE_DIR=data/models
# TOP_K=6
# HISTORY_TURNS=20
# TEMPERATURE=0.7
# WEB_SEARCH_ENABLED=true
# 博查（https://open.bochaai.com）API Key：配置后搜索链优先用它
# BOCHA_API_KEY=
# WEB_SEARCH_SOURCES=bocha,duckduckgo,so360,sogou
# DEBUG=false

# 深度思考模式（前端「深度思考」开关；详见 README）
# DEEP_THINK_MAX_STEPS=6
# DEEP_THINK_TIMEOUT_SECONDS=180
# DEEP_THINK_LLM_TIMEOUT_SECONDS=60
# DEEP_THINK_MAX_TOOL_CHARS=1200
# DEEP_THINK_MAX_FETCHES=2
# DEEP_THINK_FETCH_ENABLED=true
