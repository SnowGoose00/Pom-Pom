  "notes": [
    "统一评测集：把原先分散的四套用例（entity_probes / plot_probes / acceptance 18 题 / deep smoke）合并成一个文件，",
    "按「轴 axis + 档位 tier」组织。tier=fast 只用检索、不调模型；llm 走普通问答；deep 走深度思考（SSE）。",
    "检查项都是确定性的字符串/计数断言，不引入 LLM 判官，保证可重复、可回归。"
  ],
  "references": [
    {
      "name": "RGB: Benchmarking Large Language Models in Retrieval-Augmented Generation",
      "url": "https://github.com/chen700564/RGB",
      "used_for": "四种基础能力：噪声鲁棒性 / 否定拒绝 / 信息整合 / 反事实鲁棒性；中英双语各有独立数据文件"
    },
    {
      "name": "CRAG: Comprehensive RAG Benchmark (Meta)",
      "url": "https://github.com/facebookresearch/CRAG",
      "used_for": "五个领域 × 八类问题（simple / condition / comparison / aggregation / multi-hop / set / post-processing / false-premise），并按实体热度与时效分层"
    },
    {
      "name": "CharacterEval (中文角色扮演评测)",
      "url": "https://github.com/morecry/CharacterEval",
      "used_for": "四维十三指标的角色扮演评测：人设一致性、知识准确性、语言风格等"
    },
    {
      "name": "RAGChecker (Amazon)",
      "url": "https://github.com/amazon-science/RAGChecker",
      "used_for": "把指标分成检索端与生成端两组，便于定位问题出在召回还是作答"
    },
    {
      "name": "Ragas testset generation",
      "url": "https://docs.ragas.io/en/stable/concepts/test_data_generation/",
      "used_for": "测试集要素（question / ground truth / contexts）与「覆盖真实场景、持续更新防止数据漂移」的原则"
    },
    {
      "name": "GAIA benchmark",
      "url": "https://huggingface.co/datasets/gaia-benchmark/GAIA",
      "used_for": "按所需工具与自主程度分级（level 1/2/3），用于深度思考模式的难度分层"
    }
  ],
  "axes": {
    "grounding": "事实接地：回答依据的实体/事实确实出现在检索片段里",
    "noise": "噪声鲁棒性（RGB）：问题里混入无关内容，目标实体仍要被召回",
    "rejection": "否定拒绝（RGB / CRAG false-premise）：库里没有的就如实说没有，不编",
    "integration": "信息整合（RGB / CRAG multi-hop）：跨场景、跨篇章拼出答案",
    "counterfactual": "反事实鲁棒性（RGB）：面对错误前提要纠正，不能顺着说",
    "persona": "人设一致（CharacterEval）：自称、口癖、称谓、别称用量",
    "style": "输出风格（CharacterEval）：不出报告腔、不泄漏工具标记",
    "safety": "安全与越界：违规拒绝、超纲带开",
    "tooling": "工具使用（GAIA）：深度思考模式是否真的查了、轮数是否收敛",
    "multilingual": "多语言：跟随提问语言作答"
  },
